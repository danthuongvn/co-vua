{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'avatar', 'code'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
        "avatar": { ".validate": "newData.isString() && newData.val().length <= 8" },
        "code": { ".validate": "newData.isString() && newData.parent().parent().parent().child('codes').child(newData.val()).val() === $uid" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "stats": {
          "wins": { ".validate": "newData.isNumber()" },
          "losses": { ".validate": "newData.isNumber()" },
          "draws": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/)"
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && ((auth.uid === $from && $from !== $to && (data.exists() || (!root.child('blocks').child($to).child($from).exists() && !root.child('friends').child($to).child($from).exists()))) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'avatar', 'code', 'ts'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "avatar": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "code": { ".validate": "newData.isString()" },
          "ts": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fid": {
          ".write": "auth != null && ((auth.uid === $uid || auth.uid === $fid) && !newData.exists() || (auth.uid === $uid && root.child('friendRequests').child($uid).child($fid).exists()) || (auth.uid === $fid && root.child('friendRequests').child($fid).child($uid).exists()))",
          ".validate": "newData.hasChildren(['name', 'avatar', 'code'])"
        }
      }
    },
    "chats": {
      "$a": {
        "$b": {
          ".read": "auth != null && ((auth.uid === $a && root.child('friends').child($a).child($b).exists()) || (auth.uid === $b && root.child('friends').child($b).child($a).exists()))",
          "$msg": {
            ".write": "auth != null && !data.exists() && ((auth.uid === $a && root.child('friends').child($a).child($b).exists()) || (auth.uid === $b && root.child('friends').child($b).child($a).exists()))",
            ".validate": "newData.hasChildren(['from', 'text', 'ts']) && $a < $b",
            "from": { ".validate": "newData.val() === auth.uid" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
            "ts": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && root.child('friends').child($from).child($to).exists()) || (auth.uid === $to && !newData.exists()) || (auth.uid === $from && !newData.exists()))",
          ".validate": "newData.hasChildren(['gameId', 'name', 'avatar', 'ts'])"
        }
      }
    },
    "games": {
      "$gid": {
        ".read": "auth != null && (data.child('white').val() === auth.uid || data.child('black').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('white').val() === auth.uid && root.child('friends').child(auth.uid).child(newData.child('black').val()).exists()) || (!data.exists() && newData.child('black').val() === auth.uid && root.child('friends').child(auth.uid).child(newData.child('white').val()).exists()) || (data.exists() && (data.child('white').val() === auth.uid || data.child('black').val() === auth.uid) && newData.child('white').val() === data.child('white').val() && newData.child('black').val() === data.child('black').val()))",
        ".validate": "newData.hasChildren(['white', 'black', 'status'])"
      }
    },
    "reports": {
      "$rid": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['by', 'about', 'ts']) && newData.child('by').val() === auth.uid && newData.child('ts').val() === now"
      }
    }
  }
}
